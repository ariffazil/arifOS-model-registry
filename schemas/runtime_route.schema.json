{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "arifOS registry v3 runtime_route",
  "type": "object",
  "required": [
    "object_type",
    "object_key",
    "route_key",
    "endpoint",
    "auth_class",
    "resolves_to"
  ],
  "properties": {
    "object_type": {
      "const": "runtime_route"
    },
    "object_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "transport": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "auth_class": {
      "type": "string"
    },
    "resolves_to": {
      "type": "object",
      "required": [
        "resolution_state"
      ],
      "properties": {
        "offering_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_state": {
          "enum": [
            "matched",
            "alias_drift",
            "unresolved"
          ]
        },
        "observed_resolved_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "catalog_only_models": {
      "type": "array"
    },
    "allowed_uses": {
      "type": "array"
    },
    "forbidden_uses": {
      "type": "array"
    },
    "status": {
      "enum": [
        "active",
        "degraded",
        "hold",
        "blocked"
      ]
    }
  },
  "additionalProperties": true
}
