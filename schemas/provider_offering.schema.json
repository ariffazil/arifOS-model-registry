{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "arifOS registry v3 provider_offering",
  "type": "object",
  "required": [
    "object_type",
    "object_key",
    "offering_key",
    "provider",
    "model_release_key",
    "alias_policy",
    "offering_url"
  ],
  "properties": {
    "object_type": {
      "const": "provider_offering"
    },
    "object_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model_release_key": {
      "type": "string"
    },
    "alias_policy": {
      "enum": [
        "dated_snapshot",
        "latest_floating",
        "pinned_revision",
        "unknown"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_compat": {
      "type": "string"
    },
    "pricing_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "quota_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "deprecation_state": {
      "type": "string"
    },
    "availability": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        },
        "evidence_class": {
          "type": "string"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "failure_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
